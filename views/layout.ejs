<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>In case of emale templating</title>
    <style>
      body {
        text-align: center;
        background-color: aliceblue;
      }
    </style>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
      tailwind.config = {
        theme: {
          extend: {
            colors: {
              clifford: "#da373d",
            },
          },
        },
      };
    </script>
  </head>

  <body class="bg-red-600" style="background-color: rgb(199, 225, 227)">
    <%- include('header',{loggedin}); %>
    <div class="my-2"><%- body %></div>
  </body>
</html>
