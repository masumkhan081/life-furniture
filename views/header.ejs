<div
  class="mb-0 container-fluid py-2 d-flex justify-content-between align-items-center rounded-3 shadow-sm"
>
  <a
    href="/"
    class="py-1 badge fs-5 px-sm-3 px-2 text-decoration-none text-success rounded-3"
  >
    <i class="fa fa-home" aria-hidden="true"></i> Header made of ejs</a
  >
  <div class="d-flex flex-grow-1 justify-content-end pe-sm-4">
    <%if(loggedin==true){%>
    <a
      class="text-center text-decoration-none text-light px-2 me-2 rounded-3"
      href="/signout"
      ><i class="fa-solid fa-right-from-bracket me-1 text-warning"></i> Log
      Out</a
    >
    <%} else{%>
    <button
      class="border-2 text-dark text-center text-decoration-none rounded-3 px-2"
    >
      <i class="fa-solid fa-user"></i> I am clickable
    </button>
    <%}%>
  </div>
</div>
